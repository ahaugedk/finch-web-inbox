# Hosted values must be configured as Sites runtime secrets, never in hosting.json.
AUTH_SECRET=
RESEND_API_KEY=
# Use an address on your verified Resend domain.
# Production: Finch <login@mail.finch.dk>
EMAIL_FROM=
# Inbound mail: separate server key; the login sending key is preserved.
INBOUND_EMAIL_DOMAIN=mail.finch.dk
RESEND_INBOUND_API_KEY=
# Signing secret for the email.received webhook; never put this in browser code.
RESEND_WEBHOOK_SECRET=

# Canonical public origin for invitation links. Local previews retain localhost.
PUBLIC_ORIGIN=https://mit.finch.dk
